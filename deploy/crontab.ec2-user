#CLOUD WATCH
*/5 * * * * /usr/aws/cloudWatch/aws-scripts-mon/mon-put-instance-data.pl --mem-used-incl-cache-buff --mem-util --disk-space-util --disk-path=/ --from-cron
*/5 * * * * /usr/aws/cloudWatch/aws-scripts-mon/mon-put-instance-data.pl --mem-used-incl-cache-buff --mem-util --mem-used --mem-avail --swap-util --swap-used

# ============================================================================
# 2026-08-04 수집 크론 재설계
# 설계 문서: docs/superpowers/specs/2026-08-04-academyinfo-cron-redesign-design.md
#
# 변경 요지
#   - school-indicators: 30분 간격 롤링(중첩 발생) → 매일 1회 stale-first 13학교
#   - 모든 잡에 flock -n 적용 (중복 실행 시 큐잉 없이 스킵)
#   - 경부하 잡을 01:00~01:55에 모아 무거운 잡(02:30, 05:00)과 분리
#   - 락 파일은 /var/www/html/update/.locks/ (ec2-user 소유, /var/lock 은 권한 없음)
# ============================================================================

# BEGIN academyinfo
0 1 1 * * cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-code-year.lock timeout -k 60 1800 /usr/bin/python3 update_academyinfo.py sync-code-year --scope latest >> logs/sync_code_year.log 2>&1
10 1 * * 1 cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-school-master.lock timeout -k 60 1800 /usr/bin/python3 update_academyinfo.py sync-school-master --scope latest >> logs/sync_school_master.log 2>&1
15 1 * * 1 cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-subject-master.lock timeout -k 60 1800 /usr/bin/python3 update_academyinfo.py sync-subject-master --scope latest >> logs/sync_subject_master.log 2>&1
55 1 4 * * cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-regional.lock timeout -k 60 1800 /usr/bin/python3 update_academyinfo.py sync-regional-indicators --scope latest >> logs/sync_regional_indicator.log 2>&1
30 2 * * * cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-school-indicator.lock timeout -k 60 6000 /usr/bin/python3 update_academyinfo.py sync-school-indicators --scope latest >> logs/sync_school_indicator_batch.log 2>&1
0 5 5 * * cd /var/www/html/update/academyinfo && flock -n /var/www/html/update/.locks/academyinfo-startup.lock timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-startup-support --scope latest >> logs/sync_startup_support.log 2>&1
# END academyinfo

# BEGIN career
5 1 1 * * cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-code-list.lock timeout -k 60 1800 /usr/bin/python3 update_career.py sync-code-list >> logs/sync_code_list.log 2>&1
25 1 * * 1 cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-job-list.lock timeout -k 60 1800 /usr/bin/python3 update_career.py sync-job-list >> logs/sync_job_list.log 2>&1
30 1 * * 1 cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-school-list.lock timeout -k 60 1800 /usr/bin/python3 update_career.py sync-school-list >> logs/sync_school_list.log 2>&1
35 1 * * 1 cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-subject-list.lock timeout -k 60 1800 /usr/bin/python3 update_career.py sync-subject-list >> logs/sync_subject_list.log 2>&1
40 1 3 * * cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-job-detail.lock timeout -k 60 3600 /usr/bin/python3 update_career.py sync-job-detail >> logs/sync_job_detail.log 2>&1
45 1 4 * * cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-subject-detail.lock timeout -k 60 3600 /usr/bin/python3 update_career.py sync-subject-detail >> logs/sync_subject_detail.log 2>&1
50 1 5 * * cd /var/www/html/update/career && flock -n /var/www/html/update/.locks/career-aptitude-meta.lock timeout -k 60 1800 /usr/bin/python3 update_career.py sync-aptitude-meta >> logs/sync_aptitude_meta.log 2>&1
# END career

# ============================================================================
# 롤백용 원본 (2026-08-04 재설계 직전 상태). 문제 시 위 블록과 교체.
# ============================================================================
# BEGIN academyinfo-old
# 10 2 1 * * cd /var/www/html/update/academyinfo && timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-code-year --scope latest >> logs/sync_code_year.log 2>&1
# 20 2 * * 1 cd /var/www/html/update/academyinfo && timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-school-master --scope latest >> logs/sync_school_master.log 2>&1
# 40 2 * * 1 cd /var/www/html/update/academyinfo && timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-subject-master --scope latest >> logs/sync_subject_master.log 2>&1
# 10,40 2-22 3 * * cd /var/www/html/update/academyinfo && batch_index=$(( (10#$(date +\%H) - 2) * 2 + (10#$(date +\%M) / 30) )) && school_offset=$(( batch_index * 9 )) && echo \"[batch] offset=${school_offset} limit=9\" >> logs/sync_school_indicator_batch.log && timeout -k 60 1500 /usr/bin/python3 update_academyinfo.py sync-school-indicators --scope latest --school-offset ${school_offset} --school-limit 9 >> logs/sync_school_indicator_batch.log 2>&1
# 10 4 4 * * cd /var/www/html/update/academyinfo && timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-regional-indicators --scope latest >> logs/sync_regional_indicator.log 2>&1
# 10 5 5 * * cd /var/www/html/update/academyinfo && timeout -k 60 10800 /usr/bin/python3 update_academyinfo.py sync-startup-support --scope latest >> logs/sync_startup_support.log 2>&1
# END academyinfo-old
# BEGIN career-old
# 10 2 1 * * cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-code-list >> logs/sync_code_list.log 2>&1
# 20 2 * * 1 cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-job-list >> logs/sync_job_list.log 2>&1
# 30 2 3 * * cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-job-detail >> logs/sync_job_detail.log 2>&1
# 0 3 * * 1 cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-school-list >> logs/sync_school_list.log 2>&1
# 30 3 * * 1 cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-subject-list >> logs/sync_subject_list.log 2>&1
# 30 2 4 * * cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-subject-detail >> logs/sync_subject_detail.log 2>&1
# 30 2 5 * * cd /var/www/html/update/career && /usr/bin/python3 update_career.py sync-aptitude-meta >> logs/sync_aptitude_meta.log 2>&1
# END career-old
