import json
import os
import pymysql
import urllib.request as req
from bs4 import BeautifulSoup


def _required_env(name):
    value = os.getenv(name, "")
    if value == "":
        raise RuntimeError(f"missing env: {name}")
    return value


con = pymysql.connect(
    user=_required_env("CAREER_DB_USER"),
    passwd=_required_env("CAREER_DB_PASSWORD"),
    host=_required_env("CAREER_DB_HOST"),
    port=int(os.getenv("CAREER_DB_PORT", "3306")),
    database=os.getenv("CAREER_DB_NAME", "CAREER_DB"),
)

school_xml_url = os.getenv("CAREER_SCHOOL_XML_URL", "https://www.career.go.kr/cnet/openapi/getOpenApi.xml")
jobs_json_url = os.getenv("CAREER_JOBS_JSON_URL", "https://www.career.go.kr/cnet/front/openapi/jobs.json")
job_json_url = os.getenv("CAREER_JOB_JSON_URL", "https://www.career.go.kr/cnet/front/openapi/job.json")
apiKey = _required_env("CAREER_SERVICE_KEY")
contentType = os.getenv("CAREER_CONTENT_TYPE", "xml")


def get_jobList(page=1, *, searchThemeCode='', searchAptdCodes='', searchJobCd=''):
    full_url = jobs_json_url + '?&apiKey=' + apiKey + '&searchThemeCode=' + searchThemeCode + '&searchAptdCodes=' + searchAptdCodes + '&searchJobCd=' + searchJobCd
    f = req.urlopen(full_url + '&pageIndex=' + str(page) + '&pageSize=1000')
    data = f.read().decode('utf-8')
    return json.loads(data)


def get_jobInfo(jcode):
    job_url = job_json_url + '?&apiKey=' + apiKey + '&seq=' + str(jcode)
    f = req.urlopen(job_url)
    data = f.read().decode('utf-8')
    return json.loads(data)


def print_formJson(jdata):
    formatted_json_data = json.dumps(jdata, indent=4, ensure_ascii=False)
    print(formatted_json_data)
